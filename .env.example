# Base URL of the external hosted form endpoint used by the Get a Quote,
# Contact, and Careers/Join Our Network lead-capture forms.
# See specs/001-pranayansh-website-strategy/contracts/form-submission-contract.md
VITE_FORM_ENDPOINT=https://example-form-endpoint.test/submit

# Durgotsav Event Management Backend API
VITE_DURGOTSAV_API_BASE_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Google Analytics 4 & Google Tag Manager Configuration
# -----------------------------------------------------------------------------
# Google Tag Manager Container ID
VITE_GTM_CONTAINER_ID=GTM-MD24SRXR

# Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=G-NHXE2LCLB3

# Enable verbose console debugging of dataLayer pushes (defaults to true in dev)
VITE_ANALYTICS_DEBUG=true


# Durgotsav Event Management Backend API
VITE_DURGOTSAV_API_BASE_URL=https://dg-api.pranayansh.com/api
VITE_API_BASE_URL=https://dg-api.pranayansh.com

